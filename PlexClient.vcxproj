  <ItemGroup>
    <CustomBuild Include="media\Fonts\Text_16.fnt">
      <Message>Copying font %(Filename)</Message>
      <Command>if not exist "$(OutDir)Media\Fonts" mkdir "$(OutDir)Media\Fonts"
copy /y "%(FullPath)" "$(OutDir)Media\Fonts\%(Filename)%(Extension)" &gt;nul</Command>
      <Outputs>$(OutDir)Media\Fonts\%(Filename)%(Extension)</Outputs>
    </CustomBuild>
    <CustomBuild Include="media\Fonts\Text_22.fnt">
      <Message>Copying font %(Filename)</Message>
      <Command>if not exist "$(OutDir)Media\Fonts" mkdir "$(OutDir)Media\Fonts"
copy /y "%(FullPath)" "$(OutDir)Media\Fonts\%(Filename)%(Extension)" &gt;nul</Command>
